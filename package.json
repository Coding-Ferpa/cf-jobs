{
  "name": "cfjobs",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma open source de vagas de tecnologia da comunidade Coding Ferpa",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "tsx scripts/copy-scalar.ts && next dev",
    "build": "tsx scripts/copy-scalar.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:env": "tsx scripts/check-env.ts",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:queries": "tsx --conditions=react-server --env-file=.env scripts/smoke-queries.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "prepare": "husky",
    "copy:scalar": "tsx scripts/copy-scalar.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:migrations": "tsx scripts/check-migrations.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.32",
    "@hookform/resolvers": "^5.9.1",
    "@mozilla/readability": "^0.6.0",
    "@scalar/nextjs-api-reference": "0.11.11",
    "@sentry/nextjs": "10.70.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "ai": "^7.0.70",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "nuqs": "^2.9.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "zod": "4.4.3",
    "zod-openapi": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "1.62.1",
    "@scalar/api-reference": "1.65.1",
    "@scalar/openapi-parser": "^0.28.14",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.2.1",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
