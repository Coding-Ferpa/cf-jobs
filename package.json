{
  "name": "cfjobs",
  "version": "1.1.0",
  "private": true,
  "description": "Plataforma open source de vagas de tecnologia da comunidade Coding Ferpa",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "tsx scripts/copy-scalar.ts && next dev",
    "build": "tsx scripts/copy-scalar.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:env": "tsx scripts/check-env.ts",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:queries": "tsx --conditions=react-server --env-file=.env scripts/smoke-queries.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "prepare": "husky",
    "copy:scalar": "tsx scripts/copy-scalar.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:migrations": "tsx scripts/check-migrations.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.55",
    "@hookform/resolvers": "^5.9.1",
    "@mozilla/readability": "^0.6.0",
    "@scalar/nextjs-api-reference": "0.12.3",
    "@sentry/nextjs": "10.70.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.114",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nuqs": "^2.10.1",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "zod": "4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.63.0",
    "@scalar/api-reference": "1.72.0",
    "@scalar/openapi-parser": "^0.29.6",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
