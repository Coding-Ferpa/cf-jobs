# Copie este arquivo para `.env` e preencha os valores.
# Nunca commite `.env`. As chaves aqui precisam corresponder ao schema de
# src/lib/env.ts — `pnpm check:env` falha o CI se divergirem.

# --- Público (vai para o bundle do navegador: sem segredos) ---

# URL canônica do site. Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# URL do projeto Supabase. Local (`supabase start`): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima do Supabase — a RLS é quem protege os dados
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Servidor (segredos: apenas na Vercel/Supabase, nunca no repositório) ---

# Usada exclusivamente em Server Actions que já validaram sessão e papel
SUPABASE_SERVICE_ROLE_KEY=
# Pooler Supavisor (transaction mode) usado pelo Drizzle em runtime
DATABASE_URL=
# Conexão direta, usada por migrations
DIRECT_URL=
# Chave da NVIDIA NIM (build.nvidia.com)
NVIDIA_API_KEY=
# Modelos NIM — deixe em branco para usar os padrões do código
AI_MODEL_PRIMARY=
AI_MODEL_FALLBACK=
# Segredo dos endpoints acionados por cron (mínimo de 16 caracteres)
CRON_SECRET=
